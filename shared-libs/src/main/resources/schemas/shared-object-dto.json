{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["trainerUsername", "trainerFirstName", "trainerLastName", "active", "trainingDate", "trainingDuration", "actionType"],
        "properties": {
            "trainerUsername": {
                "type": "string"
            },
            "trainerFirstName": {
                "type": "string"
            },
            "trainerLastName": {
                "type": "string"
            },
            "active": {
                "type": "boolean"
            },
            "trainingDate":{
                "type": "string", "format": "date"
            },
            "trainingDuration":{
                "type": "integer"
            },
            "actionType":{
                "type": "string", "enum":["ADD", "DELETE"]
            }
        },
    "additionalProperties": true
}
