<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             version="3.0"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence">
    <persistence-unit name="test" transaction-type="RESOURCE_LOCAL">

        <class>kg.biamino.projects.model.User</class>
        <class>kg.biamino.projects.model.Training</class>
        <class>kg.biamino.projects.model.TrainingType</class>
        <class>kg.biamino.projects.model.Trainee</class>
        <class>kg.biamino.projects.model.Trainer</class>

        <properties>
            <property name="hibernate.jdbc.time_zone" value="UTC"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:epam-test;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>

</persistence>
